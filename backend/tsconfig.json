{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",

    "rootDir": ".",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,

    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,

    "isolatedModules": true,

    "types": [
      "node",
      "jest"
    ]
  },

  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "migrations"
  ]
}