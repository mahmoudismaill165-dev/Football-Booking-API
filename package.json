{
  "name": "koora-arena-nodejs",
  "version": "1.0.0",
  "private": true,
  "description": "Koora Arena_Node.js - Football Pitch Booking & Tournament Platform",
  "scripts": {
    "dev": "npm run dev:backend",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:backend": "npm --prefix backend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix backend run test",
    "test:backend": "npm --prefix backend run test",
    "seed": "npm --prefix backend run seed",
    "db:migrate": "npm --prefix backend run db:migrate",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
